# Zee on the website (Make with Zee, Ask Zee): Firebase AI Logic in project zipyzee-e92f1, protected by App Check.
# Copy to .env.local and fill in. These values are public by design (they ship in the page); access is limited by
# App Check, not by keeping them secret. Steps: docs/WEB_PLAN.md "Zee on the web: setup".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zipyzee-e92f1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zipyzee-e92f1
NEXT_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key registered for the web app in App Check (needed in production)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Optional, development only: a debug token you added in App Check → Manage debug tokens
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Optional: the Gemini model (default: the app's gemini-3.1-flash-lite)
NEXT_PUBLIC_ZEE_MODEL=
