// Firestore rules for the whole zipyzee-e92f1 database, deployed from the website project (firebase deploy --only
// firestore). The Android app shares this database: these are the app's rules (ZipyZee/firestore.rules) plus the
// website's own (ZeeShare). One ruleset per database, so a deploy from either project replaces everything: deploy
// from here, and copy any change to the app's rules into this file first.
rules_version = '2';

// ZipyZee chat. Everything is denied unless a rule below allows it.
//   users/{uid}                 public profile: name, username, role, findable (in search), lastSeen (no email)
//   users/{uid}/private/tokens  push tokens, owner only
//   users/{uid}/private/account email, sign-in method, created time: the full account record, owner only
//   users/{uid}/private/resumeDetails  resume details the person chose to save (no photo), owner only
//   users/{uid}/private/blocks  the people this person blocked ({ uids }), owner only; one-to-one messages from them are refused
//   users/{uid}/zee/{convId}/messages/*  Zee (AI assistant) conversations, owner only, deleted 24 h after they start
//   usernames/{username}        { uid }: makes usernames unique; readable without an account (Sign up's "Available")
//   chats/{chatId}              members, unread counts, readAt; direct chat id = the two uids, sorted, joined by "_"
//   chats/{chatId}/messages/*   text / file / link, expiresAt = now + 24 h, moved to 1 h after everyone has seen it
//                               (TTL policy deletes them)
//   chats/{chatId}/files/{msgId}/chunks/{n}  a chat file's base64 pieces (free plan), expiresAt + TTL like messages
//   emailCodes/{uid}            verification codes, Cloud Functions only
//   config/support              { username }: the owner's account, shown to everyone as the pinned "ZipyZee Team" chat;
//                               set in the Firebase console only. Support chat messages live 30 days, not 24 h
//   config/app                  { minVersion }: the oldest app version still allowed (console only)
//   toolVotes/{toolId}          { count }: how many people want a coming-soon tool; anyone reads it
//   toolVotes/{toolId}/voters/{uid}  { at }: one vote per signed-in person; the count moves by one with it
//   toolRequests/{id}           { name, details, by, uid, createdAt }: "Request a tool" (by = who suggested it); write-only
//   reports/{id}                { kind, chatId?, msgId?, reported?, text?, by, createdAt }: Report; write-only
// The app keeps chat.last and unread counts up to date itself when it sends or deletes, so chat works on the free
// Firebase plan. Cloud Functions (Blaze plan) add push, link titles, view-once and file clean-up; they use the
// Admin SDK and skip these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // the ZipyZee Team account (role 'admin', set in the Firebase console only)
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function validUsername(u) { return u is string && u.matches('^[a-z0-9_][a-z0-9._]{1,18}[a-z0-9_]$'); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 60; }
    // what the app lets people choose; 'admin' (the ZipyZee Team account) is set in the console only
    function validRole(r) { return r in ['student', 'professional', 'other']; }
    function chatDoc(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)); }
    // The support account (config/support's username). Chats with it keep messages 30 days.
    // config/support { username } overrides the built-in support account (SUPPORT_USERNAME in src/config.ts)
    function supportName() {
      let cfg = /databases/$(database)/documents/config/support;
      return exists(cfg) ? get(cfg).data.username : 'zipyzee';
    }
    function isSupport(chatId) {
      let name = /databases/$(database)/documents/usernames/$(supportName());
      return exists(name) && get(name).data.uid in chatId.split('_');
    }
    // "Deletes 1 hour after it's seen": a reader may only move a delete time earlier, to about an hour from now.
    function seenLife(t, old) {
      return t is timestamp && t < old
        && t > request.time + duration.value(30, 'm') && t < request.time + duration.value(90, 'm');
    }
    // Voice messages: once everyone it was sent to has played it, it deletes a minute later (1-5 min from now).
    function heardLife(t, old) {
      return t is timestamp && t < old && t > request.time && t < request.time + duration.value(5, 'm');
    }
    // A new message's expiresAt: 24 h after now, or 30 days in the support chat (both with an hour's slack for clocks).
    function validLife(chatId, t) {
      return (t > request.time + duration.value(23, 'h') && t < request.time + duration.value(25, 'h'))
        || (t > request.time + duration.value(719, 'h') && t < request.time + duration.value(721, 'h') && isSupport(chatId));
    }

    match /config/support {
      allow get: if true;
    }
    // { minVersion: "1.1.0" }: older apps show "Update ZipyZee" and can't be used (src/components/ForceUpdate.tsx)
    match /config/app {
      allow get: if true;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // Delete account: the person removes their own profile, or the team carries out a deletion request
      allow delete: if signedIn() && (me() == uid || isAdmin());

      // Created once, together with usernames/{username} in the same batch.
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'username', 'role', 'findable', 'lastSeen'])
        && validName(request.resource.data.name)
        && (!('findable' in request.resource.data) || request.resource.data.findable is bool)
        && validUsername(request.resource.data.username)
        && validRole(request.resource.data.role)
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == request.time)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // The username never changes; lastSeen is always the server time. deleteAt / wasFindable: Delete account waits
      // 7 days (hidden from search meanwhile, TTL deletes the profile after); signing in again removes them.
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'findable', 'lastSeen', 'deleteAt', 'wasFindable'])
        && deletionDate()
        && (!('wasFindable' in request.resource.data) || request.resource.data.wasFindable is bool)
        && validName(request.resource.data.name)
        // the role is checked only when it changes, so the console-set admin role doesn't block "last seen" or the name
        && (!('role' in request.resource.data.diff(resource.data).affectedKeys()) || validRole(request.resource.data.role))
        && (!('findable' in request.resource.data) || request.resource.data.findable is bool)
        && (!('lastSeen' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastSeen == request.time);

      match /private/{docId} {
        allow read, delete: if signedIn() && (me() == uid || isAdmin());
        allow update: if signedIn() && me() == uid && deletionMark();
        allow write: if signedIn() && me() == uid && (docId != 'account' || validAccount(request.resource.data))
          && (docId != 'resumeDetails' || validResumeDetails(request.resource.data))
          && (docId != 'blocks' || (request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids is list && request.resource.data.uids.size() <= 1000));
      }

      // Zee, the AI assistant: the person's own conversations, kept 24 hours (TTL), owner only. Answers are written
      // by the app (it calls Gemini through Firebase AI Logic), so both roles are the owner's writes.
      match /zee/{convId} {
        allow read, delete: if signedIn() && (me() == uid || isAdmin());
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['title', 'createdAt', 'expiresAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
        // Rename, and the short title + summary Zee writes after its first answer: only those two fields change
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'summary'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && (!('summary' in request.resource.data) || (request.resource.data.summary is string
              && request.resource.data.summary.size() <= 300));

        match /messages/{msgId} {
          allow read, delete: if signedIn() && (me() == uid || isAdmin());
          allow create: if signedIn() && me() == uid
            && request.resource.data.keys().hasOnly(['role', 'text', 'createdAt', 'expiresAt'])
            && request.resource.data.role in ['user', 'model']
            && request.resource.data.text is string && request.resource.data.text.size() <= 20000
            && request.resource.data.createdAt == request.time
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
        }
      }

      // Saved resume details (Resume, "Save your details for next time"): the words of every section, no photo.
      function validResumeDetails(d) {
        return d.keys().hasOnly(['content', 'updatedAt']) && d.content is map && d.updatedAt == request.time;
      }

      // The email is the one on the sign-in account, so nobody can claim someone else's address.
      function validAccount(d) {
        return d.keys().hasOnly(['email', 'provider', 'createdAt'])
          && d.email == request.auth.token.email
          && d.provider in ['password', 'google']
          && d.createdAt is timestamp;
      }
    }

    // Account deletion requests (the website's Delete account): the person files one (their account is hidden and
    // marked deleteAt = in 7 days) or withdraws it by signing in again; the team (isAdmin) sees them all and, once the 7
    // days are over, deletes the account and marks the request done (name and email removed, only the dates kept).
    match /deleteRequests/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'email', 'requestedAt', 'deleteAt', 'status'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.username is string && request.resource.data.username.size() <= 40
        && request.resource.data.deleteAt is timestamp && request.resource.data.deleteAt <= request.time + duration.value(8, 'd');
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'requestedAt', 'deleteAt', 'status', 'doneAt'])
        && request.resource.data.status == 'deleted' && request.resource.data.doneAt == request.time;
      // withdrawn by the person (signed in again), or cleared by the team
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    // Delete account waits 7 days: a deleteAt no further than 8 days ahead (or none: restored)
    function deletionDate() {
      return !('deleteAt' in request.resource.data)
        || (request.resource.data.deleteAt is timestamp && request.resource.data.deleteAt <= request.time + duration.value(8, 'd'));
    }
    function deletionMark() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleteAt']) && deletionDate();
    }
    match /usernames/{name} {
      allow get: if true;
      // Delete account: the username becomes free again (the person, or the team when it carries out a request)
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      // Delete account (7 days to change your mind): deleteAt set, or removed when you sign in again
      allow update: if signedIn() && resource.data.uid == me() && deletionMark();
      allow create: if signedIn()
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/users/$(me())).data.username == name;
    }

    match /chats/{chatId} {
      // get on a missing direct chat is allowed so "Message" can check before creating it.
      allow get: if signedIn() && (resource == null || me() in resource.data.members);
      allow list: if signedIn() && me() in resource.data.members;

      allow create: if verified() && validNewChat(chatId, request.resource.data);

      // Members may: mark the chat read (their own unread = 0 and readAt = now), leave a group, update the preview and
      // the others' unread counts with a message they just sent, or fix the preview after deleting their last message.
      allow update: if signedIn() && me() in resource.data.members
        && (markRead() || leaveGroup() || sentMessage(chatId) || deletedLast(chatId) || seenLast(chatId) || heardLast(chatId) || setEmergency());

      // the preview of a voice message everyone has played deletes with it, a minute from now
      function heardLast(chatId) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
          && request.resource.data.last.diff(resource.data.last).affectedKeys().hasOnly(['expiresAt'])
          && resource.data.last.kind == 'voice'
          && heardLife(request.resource.data.last.expiresAt, resource.data.last.expiresAt);
      }

      // Emergency voice (1-to-1 chats): each person turns it on or off for themselves only
      function setEmergency() {
        let old = resource.data.get('emergency', {});
        let now = request.resource.data.emergency;
        return resource.data.type == 'direct'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emergency'])
          && now is map && now.diff(old).affectedKeys().hasOnly([me()])
          && now[me()] is bool;
      }

      // the preview of a message that was just seen deletes with it, an hour from now
      function seenLast(chatId) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
          && request.resource.data.last.diff(resource.data.last).affectedKeys().hasOnly(['expiresAt'])
          && seenLife(request.resource.data.last.expiresAt, resource.data.last.expiresAt)
          && !isSupport(chatId);
      }

      function validNewChat(chatId, d) {
        return d.keys().hasOnly(['type', 'members', 'name', 'createdBy', 'unread', 'readAt', 'last'])
          && d.createdBy == me()
          && d.members is list
          && me() in d.members
          && d.members.toSet().size() == d.members.size()
          && d.unread is map
          && d.readAt is map && d.readAt.size() == 0
          && (
            (d.type == 'direct'
              && d.members.size() == 2
              && d.members[0] < d.members[1]
              && chatId == d.members[0] + '_' + d.members[1]
              && !('last' in d) && !('name' in d))
            || (d.type == 'group'
              && d.members.size() >= 2 && d.members.size() <= 50
              && validName(d.name)
              && (!('last' in d) || (d.last.kind == 'system' && d.last.from == me() && d.last.at == request.time)))
          );
      }

      function markRead() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['unread', 'readAt'])
          && request.resource.data.unread.diff(resource.data.unread).affectedKeys().hasOnly([me()])
          && request.resource.data.unread[me()] == 0
          && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([me()])
          && request.resource.data.readAt[me()] == request.time;
      }

      // In the same batch as the new message: last = that message (sent by me, now), unread +1 for everyone else.
      function sentMessage(chatId) {
        let d = request.resource.data;
        let l = d.last;
        let msg = /databases/$(database)/documents/chats/$(chatId)/messages/$(l.id);
        let others = resource.data.members.toSet().difference([me()].toSet());
        let bumped = d.unread.diff(resource.data.unread).affectedKeys();
        return verified()
          && d.diff(resource.data).affectedKeys().hasOnly(['last', 'unread'])
          && l.keys().hasOnly(['id', 'kind', 'text', 'from', 'at', 'expiresAt'])
          && l.from == me() && l.at == request.time
          && l.kind in ['text', 'file', 'link', 'viewOnce', 'voice']
          && l.text is string && l.text.size() <= 200
          && l.expiresAt is timestamp
          && existsAfter(msg) && getAfter(msg).data.from == me() && getAfter(msg).data.createdAt == request.time
          && bumped.difference(others).size() == 0
          && (resource.data.type != 'direct' || unreadPlusOne(resource.data.members[0] == me() ? resource.data.members[1] : resource.data.members[0]));
      }

      function unreadPlusOne(u) {
        return request.resource.data.unread[u] == resource.data.unread.get(u, 0) + 1;
      }

      // After deleting my message that was the preview: the preview says "Message deleted", same time and expiry.
      function deletedLast(chatId) {
        let old = resource.data.last;
        let l = request.resource.data.last;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
          && old.from == me() && 'id' in old
          && !existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(old.id))
          && l.keys().hasOnly(['kind', 'text', 'from', 'at', 'expiresAt'])
          && l.kind == 'system' && l.text == 'Message deleted' && l.from == me()
          && l.at == old.at && l.expiresAt == old.expiresAt;
      }

      function leaveGroup() {
        return resource.data.type == 'group'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())
          && request.resource.data.members.size() == resource.data.members.size() - 1;
      }

      match /messages/{msgId} {
        allow read: if signedIn() && me() in chatDoc(chatId).data.members;
        allow create: if verified() && me() in chatDoc(chatId).data.members && validMessage(chatId, msgId, request.resource.data);
        // Delete for both: only the sender. Messages aren't changed (Cloud Functions set opened / titles), except that a
        // member who has seen someone else's message moves its delete time to an hour from now (not in support chats),
        // and the sender may edit a text message's words for 5 minutes after sending it (editText; the app's Edit).
        // ...and once a message's delete time has passed, any member may delete it (Firestore's TTL can take hours)
        allow delete: if signedIn()
          && (resource.data.from == me() || (me() in chatDoc(chatId).data.members && resource.data.expiresAt < request.time));
        allow update: if signedIn() && me() in chatDoc(chatId).data.members
          && ((resource.data.from != me()
            && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
              && seenLife(request.resource.data.expiresAt, resource.data.expiresAt)
              && !isSupport(chatId))
              || heardVoice()))
            || editText());

        // Edit: my own text message, within 5 minutes of sending it; only the words change (1 to 4000 characters), and
        // editedAt is the server's time.
        function editText() {
          let d = request.resource.data;
          let old = resource.data;
          return old.from == me()
            && old.kind == 'text'
            && request.time < old.createdAt + duration.value(5, 'm')
            && d.diff(old).affectedKeys().hasOnly(['text', 'editedAt'])
            && d.text is string && d.text.size() > 0 && d.text.size() <= 4000
            && d.editedAt == request.time;
        }

        // A voice message I played: I add myself to `heard`; the last one to play it moves its delete time to a minute.
        function heardVoice() {
          let d = request.resource.data;
          let old = resource.data;
          return old.kind == 'voice'
            && d.diff(old).affectedKeys().hasOnly(['heard', 'expiresAt'])
            && d.heard is list && d.heard.size() <= 50
            && d.heard.toSet() == old.get('heard', []).toSet().union([me()].toSet())
            && (d.expiresAt == old.expiresAt || heardLife(d.expiresAt, old.expiresAt));
        }

        function validMessage(chatId, msgId, d) {
          return d.from == me()
            && !blocked(chatId)
            && d.createdAt == request.time
            && d.expiresAt is timestamp
            && validLife(chatId, d.expiresAt)
            && (validText(d) || validLink(d) || validFile(chatId, msgId, d) || validVoice(chatId, msgId, d));
        }

        // Block: in a one-to-one chat, nobody sends while either of the two has blocked the other.
        function blocked(chatId) {
          let c = chatDoc(chatId).data;
          return c.get('type', 'direct') != 'group' && c.members.size() == 2
            && (blocks(c.members[0], c.members[1]) || blocks(c.members[1], c.members[0]));
        }
        function blocks(uid, other) {
          let p = /databases/$(database)/documents/users/$(uid)/private/blocks;
          return exists(p) && other in get(p).data.get('uids', []);
        }

        // Voice messages: up to a minute of AAC (about 720 KB) in Firestore pieces, groups too.
        function validVoice(chatId, msgId, d) {
          return d.kind == 'voice'
            && d.keys().hasOnly(['from', 'kind', 'file', 'duration', 'createdAt', 'expiresAt'])
            && d.file.keys().hasOnly(['path', 'name', 'size', 'mimeType', 'chunks'])
            && d.file.name == 'voice.aac' && d.file.mimeType == 'audio/aac'
            && d.file.size is int && d.file.size > 0 && d.file.size <= 1024 * 1024
            && d.file.chunks is int && d.file.chunks >= 1 && d.file.chunks <= 2
            && d.file.path == 'chats/' + chatId + '/' + msgId + '/voice.aac'
            && d.duration is number && d.duration >= 1 && d.duration <= 61;
        }

        function validText(d) {
          return d.kind == 'text'
            && d.keys().hasOnly(['from', 'kind', 'text', 'createdAt', 'expiresAt'])
            && d.text is string && d.text.size() > 0 && d.text.size() <= 4000;
        }

        function validLink(d) {
          return d.kind == 'link'
            && d.keys().hasOnly(['from', 'kind', 'link', 'text', 'createdAt', 'expiresAt'])
            && d.link.keys().hasOnly(['url', 'domain'])
            && d.link.url is string && d.link.url.size() <= 2000 && d.link.url.matches('https?://.+')
            && d.link.domain is string && d.link.domain.size() <= 255
            && (!('text' in d) || (d.text is string && d.text.size() <= 500));
        }

        // Files: in Firestore pieces up to 5 MB (free plan), or in Cloud Storage up to 25 MB (Blaze). View once (Storage
        // only): 1-to-1 chats, never saveable, stored where nobody can read it.
        function validFile(chatId, msgId, d) {
          return d.kind == 'file'
            && d.keys().hasOnly(['from', 'kind', 'file', 'viewOnce', 'allowSave', 'text', 'createdAt', 'expiresAt'])
            // a caption sent with the file (like WhatsApp), optional
            && (!('text' in d) || (d.text is string && d.text.size() > 0 && d.text.size() <= 1000))
            && d.file.keys().hasOnly(['path', 'name', 'size', 'mimeType', 'pages', 'chunks'])
            && d.file.name is string && d.file.name.size() > 0 && d.file.name.size() <= 200
            // a plain file name: no folders (/ or \) and not "." / "..", so it can't reach outside a folder on the phone
            && !d.file.name.matches('.*[/\\\\].*') && !d.file.name.matches('[.]+')
            && d.file.size is int && d.file.size > 0 && d.file.size <= 25 * 1024 * 1024
            && d.file.mimeType is string
            && d.viewOnce is bool && d.allowSave is bool
            && (
              // kept in Firestore (free plan): up to 5 MB in 1-9 pieces, never view once
              ('chunks' in d.file
                && d.file.chunks is int && d.file.chunks >= 1 && d.file.chunks <= 9
                && d.file.size <= 5 * 1024 * 1024
                && d.viewOnce == false
                && d.file.path == 'chats/' + chatId + '/' + msgId + '/' + d.file.name)
              || (!('chunks' in d.file) && d.viewOnce == false && d.file.path == 'chats/' + chatId + '/' + msgId + '/' + d.file.name)
              || (!('chunks' in d.file) && d.viewOnce == true && d.allowSave == false && chatDoc(chatId).data.type == 'direct'
                && d.file.path == 'viewonce/' + chatId + '/' + msgId + '/' + d.file.name)
            );
        }
      }

      // A chat file kept in Firestore (free plan, no Cloud Storage): base64 pieces 0..8, written by the sender before
      // the message, readable by the chat's members, deleted by the sender with the message or by the TTL policy.
      match /files/{msgId}/chunks/{piece} {
        allow read: if signedIn() && me() in chatDoc(chatId).data.members;
        allow create: if verified() && me() in chatDoc(chatId).data.members
          && piece in ['0', '1', '2', '3', '4', '5', '6', '7', '8']
          && request.resource.data.keys().hasOnly(['d', 'from', 'expiresAt'])
          && request.resource.data.from == me()
          && request.resource.data.d is string && request.resource.data.d.size() > 0 && request.resource.data.d.size() <= 800000
          && request.resource.data.expiresAt is timestamp
          && (request.resource.data.expiresAt < request.time + duration.value(25, 'h')
            || (request.resource.data.expiresAt < request.time + duration.value(721, 'h') && isSupport(chatId)));
        allow delete: if signedIn()
          && (resource.data.from == me() || (me() in chatDoc(chatId).data.members && resource.data.expiresAt < request.time));
        // the file's pieces delete with the seen message, an hour from now (a played voice message: a minute)
        allow update: if signedIn() && me() in chatDoc(chatId).data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          && ((seenLife(request.resource.data.expiresAt, resource.data.expiresAt) && !isSupport(chatId))
            || (heardLife(request.resource.data.expiresAt, resource.data.expiresAt)
              && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(msgId)).data.kind == 'voice'));
      }
    }

    // ---------- tool votes and requests (All tools) ----------
    // Only real tools can be voted for: the server, AI and coming-soon tools (VOTABLE_IDS in src/tools/registry.ts).
    function votable(toolId) {
      return toolId in ['compress-pdf', 'redact-pdf', 'repair-pdf', 'pdf-to-pdfa', 'upscale-image', 'object-eraser',
        'searchable-pdf', 'urdu-ocr', 'word-to-pdf', 'ppt-to-pdf', 'excel-to-pdf', 'pdf-to-word', 'pdf-to-ppt',
        'pdf-to-excel', 'pdf-to-text', 'ai-summary', 'chat-pdf', 'translate-pdf', 'study-helper', 'camera-translate'];
    }
    function voterPath(toolId) { return /databases/$(database)/documents/toolVotes/$(toolId)/voters/$(request.auth.uid); }
    function votePath(toolId) { return /databases/$(database)/documents/toolVotes/$(toolId); }
    function countBefore(toolId) { return exists(votePath(toolId)) ? get(votePath(toolId)).data.count : 0; }

    match /toolVotes/{toolId} {
      allow read: if true;
      // +1 together with this person's new voter doc, or -1 together with deleting it
      allow create, update: if signedIn() && votable(toolId)
        && request.resource.data.keys().hasOnly(['count'])
        && ((request.resource.data.count == countBefore(toolId) + 1 && !exists(voterPath(toolId)) && existsAfter(voterPath(toolId)))
          || (request.resource.data.count == countBefore(toolId) - 1 && exists(voterPath(toolId)) && !existsAfter(voterPath(toolId))));

      match /voters/{uid} {
        allow get: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && votable(toolId)
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && getAfter(votePath(toolId)).data.count == countBefore(toolId) + 1;
        allow delete: if signedIn() && me() == uid
          && getAfter(votePath(toolId)).data.count == countBefore(toolId) - 1;
      }
    }

    // Reports (Google Play's user-generated content and AI policies): a person, a chat message or one of Zee's answers,
    // reported by the signed-in person as themselves; chat reports only from a member of that chat. Write-only: the
    // team reads them in the console.
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'chatId', 'msgId', 'reported', 'text', 'by', 'createdAt'])
        && request.resource.data.by == me()
        && request.resource.data.kind in ['message', 'user', 'ai']
        && request.resource.data.createdAt == request.time
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
        && (!('reported' in request.resource.data) || (request.resource.data.reported is string && request.resource.data.reported.size() <= 128))
        && (!('msgId' in request.resource.data) || (request.resource.data.msgId is string && request.resource.data.msgId.size() <= 128))
        && (request.resource.data.kind == 'ai'
          ? !('chatId' in request.resource.data)
          : (request.resource.data.chatId is string && me() in chatDoc(request.resource.data.chatId).data.members));
    }

    match /toolRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'details', 'by', 'uid', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 50
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 500))
        && (!('by' in request.resource.data) || (request.resource.data.by is string && request.resource.data.by.size() <= 60))
        && request.resource.data.createdAt == request.time;
    }
    // ZeeShare (the website; the app later): two devices share text, photos and files and stay paired until one taps
    // Disconnect. No account. Pairing: a 6-digit room holds the host's WebRTC offer and ECDH public key for 15 minutes;
    // the guest adds its answer, name and public key once. On Allow both derive the same secret, the session's id (32
    // hex characters, never written anywhere and impossible to guess), and the room is deleted (`sid` is written into
    // it only by browsers without WebCrypto, i.e. plain-http development). The session holds new offers / answers for
    // reconnecting and lives 30 days after either device last had it open (TTL on expiresAt). Continuing an ended
    // session, the guest adds `proof` (sha256 of the old session id + code) so the host lets it straight back in. Things sent while there's
    // no direct link wait in items / pieces (7 days at most); the receiver deletes them as soon as it has them.
    function zsLife(d, span) {
      return d.expiresAt is timestamp && d.expiresAt <= request.time + span;
    }
    function zsString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }
    function zsSession(sid) {
      return exists(/databases/$(database)/documents/zeeshare/$(sid));
    }
    match /zeeshareRooms/{code} {
      allow get: if code.matches('[1-9][0-9]{5}');
      allow create: if code.matches('[1-9][0-9]{5}')
        && request.resource.data.keys().hasOnly(['offer', 'hostName', 'hostPub', 'createdAt', 'expiresAt'])
        && request.resource.data.offer is string && zsString(request.resource.data, 'offer', 30000)
        && request.resource.data.hostName is string && zsString(request.resource.data, 'hostName', 60)
        && zsString(request.resource.data, 'hostPub', 200)
        && request.resource.data.createdAt == request.time
        && zsLife(request.resource.data, duration.value(16, 'm'));
      // the guest's answer, once; then (plain-http development only) the session id
      allow update: if (!('answer' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'guestName', 'guestPub', 'proof'])
          && request.resource.data.answer is string && zsString(request.resource.data, 'answer', 30000)
          && zsString(request.resource.data, 'guestName', 60) && zsString(request.resource.data, 'guestPub', 200)
          && zsString(request.resource.data, 'proof', 64))
        || ('answer' in resource.data && !('sid' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sid'])
          && request.resource.data.sid is string && request.resource.data.sid.matches('[0-9a-f]{32}'));
      allow delete: if true;
    }
    match /zeeshare/{sid} {
      // get by id only (no listing): only the two paired devices know the id
      allow get, delete: if sid.matches('[0-9a-f]{32}');
      allow create: if sid.matches('[0-9a-f]{32}')
        && request.resource.data.keys().hasOnly(['hostName', 'guestName', 'createdAt', 'expiresAt'])
        && zsString(request.resource.data, 'hostName', 60) && zsString(request.resource.data, 'guestName', 60)
        && request.resource.data.createdAt == request.time
        && zsLife(request.resource.data, duration.value(31, 'd'));
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sig', 'sigAnswer', 'sigWant', 'expiresAt'])
        && zsLife(request.resource.data, duration.value(31, 'd'))
        && (!('sig' in request.resource.data) || (request.resource.data.sig is map && request.resource.data.sig.keys().hasOnly(['epoch', 'by', 'offer']) && zsString(request.resource.data.sig, 'offer', 30000)))
        && (!('sigAnswer' in request.resource.data) || (request.resource.data.sigAnswer is map && request.resource.data.sigAnswer.keys().hasOnly(['epoch', 'by', 'answer']) && zsString(request.resource.data.sigAnswer, 'answer', 30000)))
        && (!('sigWant' in request.resource.data) || request.resource.data.sigWant is int);

      match /items/{id} {
        allow read, delete: if zsSession(sid);
        allow create: if zsSession(sid) && id.matches('[a-z0-9]{1,40}')
          && request.resource.data.keys().hasOnly(['from', 'kind', 'text', 'name', 'mime', 'size', 'pieces', 'at', 'expiresAt'])
          && request.resource.data.from in ['host', 'guest']
          && request.resource.data.kind in ['text', 'file']
          && zsString(request.resource.data, 'text', 100000) && zsString(request.resource.data, 'name', 255) && zsString(request.resource.data, 'mime', 120)
          && (!('pieces' in request.resource.data) || (request.resource.data.pieces is int && request.resource.data.pieces <= 32))
          && zsLife(request.resource.data, duration.value(8, 'd'));
      }
      match /pieces/{id} {
        allow get, delete: if zsSession(sid);
        allow create: if zsSession(sid)
          && request.resource.data.keys().hasOnly(['d', 'expiresAt'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 750000
          && zsLife(request.resource.data, duration.value(8, 'd'));
      }
    }
  }
}
